#!/usr/bin/env zsh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$ROOT_DIR/shared/tools/lib"

# --debug streams every captured third-party command to the console as well as
# to the run log; --trace adds zsh xtrace on top. Both are exported, so they
# reach the sub-installers, which are separate processes.
for arg in "$@"; do
  parse_debug_arg "$arg" && continue
  error "Unknown argument: $arg (accepted: --debug, --trace)"
done
trace_enabled && setopt xtrace

# The CLI binary comes before anything that configures it. Install-or-update:
# absent installs from the vendor bootstrapper, present runs `agy update`.
"$SCRIPT_DIR/tools/bootstrap-cli" || warn "Antigravity CLI bootstrap failed"

info "Installing Antigravity CLI configuration..."
mkdir -p "$GEMINI_DIR/config/hooks" "$GEMINI_DIR/config/skills" "$GEMINI_DIR/config/rules" "$ANTIGRAVITY_DIR"

clean_dead_symlinks "$GEMINI_DIR"

apply_manifest "$SCRIPT_DIR/config/manifest.txt"

# Run shared and Antigravity-specific tool installers
for tool_script in "$ROOT_DIR/shared/tools/install-"*(N) "$SCRIPT_DIR/tools/install-"*(N); do
  [[ -x "$tool_script" ]] || continue
  info "Running $(basename "$tool_script")..."
  "$tool_script" || warn "$(basename "$tool_script") failed"
done

success "Antigravity CLI configuration installed."
report_log_location
prune_run_logs
