{
  "hooks": {
    "PreInvocation": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/adhd-mode-inject-skill"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/session-stop-memory-reminder"
          }
        ]
      }
    ]
  }
}
