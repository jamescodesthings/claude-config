#!/usr/bin/env zsh
# Installs the Superpowers plugin into Antigravity.
#
# Claude Code needs Superpowers too (CLAUDE.md routes most work through
# `superpowers:*` skills), but it installs by a completely different mechanism.
# That half lives in claude/tools/install-plugins. This script used to sit in
# shared/tools/, which claude/install also globs, so `agy plugin install` ran
# during the Claude install while Claude itself got nothing: the whole reason
# /doctor reported Superpowers missing.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
source "$ROOT_DIR/shared/tools/lib"

command -v agy &> /dev/null || { warn "agy not found, Superpowers-for-Antigravity skipped"; exit 0 }

# Absent means install, present means update. `agy plugin` has no update verb
# (list/import/install/uninstall/enable/disable/validate/link only), so
# re-running install is the upgrade path.
if agy plugin list 2>/dev/null | grep -q '"superpowers"'; then
  info "Updating Superpowers in Antigravity..."
  verb=Updated
else
  info "Installing Superpowers plugin in Antigravity..."
  verb=Installed
fi

agy plugin install https://github.com/obra/superpowers &> /dev/null \
  || { warn "Superpowers install into Antigravity failed"; exit 0 }

success "$verb Superpowers plugin in Antigravity"
