#!/usr/bin/env zsh
# Updates the third-party pieces Agent Forge installs, for whichever of them
# are actually present.
#
# `make install` deliberately cannot do this. Every sub-installer short-circuits
# on "already installed" so that re-running after a git pull is cheap and
# idempotent, which also means a tool installed once never moves again. This
# script is the other half: install puts things there, update moves them
# forward. Neither installs what the other should.
#
# Claude Code's own binary is not touched here. It self-updates (see
# ~/.claude/.last-update-result.json) and racing that would only cause
# trouble.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lib"

info "Updating Agent Forge managed tools..."

if command -v claude &> /dev/null; then
  installed=$(claude plugin list 2>/dev/null)
  for ref in superpowers@superpowers-dev commit-commands@claude-plugins-official \
             context7@claude-plugins-official caveman@caveman; do
    print -r -- "$installed" | grep -q "$ref" || continue
    info "Updating plugin $ref..."
    claude plugin update "$ref" &> /dev/null || warn "$ref update failed"
  done
  success "Claude plugins updated"
else
  warn "claude CLI not found, plugin updates skipped"
fi

if command -v agy &> /dev/null; then
  # `agy plugin` has no update verb (list/import/install/uninstall/enable/
  # disable/validate/link only), so re-running install is the upgrade path.
  if agy plugin list 2>/dev/null | grep -q '"superpowers"'; then
    info "Refreshing Superpowers in Antigravity..."
    agy plugin install https://github.com/obra/superpowers &> /dev/null \
      || warn "Superpowers refresh in Antigravity failed"
  fi
  success "Antigravity plugins updated"
else
  warn "agy not found, Antigravity updates skipped"
fi

if command -v rtk &> /dev/null; then
  info "rtk: $(rtk --version 2>/dev/null || print -r -- 'version unknown')"
  warn "rtk has no self-update; re-run shared/tools/install-rtk after removing the binary to move versions"
fi

if command -v uv &> /dev/null && uv tool list 2>/dev/null | grep -q "^claude-monitor"; then
  info "Updating claude-monitor..."
  uv tool upgrade claude-monitor &> /dev/null || warn "claude-monitor upgrade failed"
  success "claude-monitor updated"
fi

success "Update pass complete. Restart any running CLI session to pick up plugin changes."
