#!/usr/bin/env zsh
# Reverse of graduate: moves a public skill or memory back into the encrypted
# WIP tier, stripping it from the public dir/index and giving it a fresh
# fuzzed name (skills): a demoted item is hidden again, so it gets the same
# name-fuzzing treatment as anything newly scaffolded into WIP.
repo_root="${0:A:h}/../.."
type="${${0:t}%-*}"
source "$repo_root/shared/tools/lib"

name="$1"
[[ -n "$name" ]] || error "Usage: ${0:t} <name>"

IFS=':' read -r wip_root enc_root shape pub_root pub_index wip_index <<< "$(wip_type_config "$type")" \
  || error "Unknown wip type '$type' (invoked as ${0:t}: expected skill-demote or memory-demote)"
[[ -n "$pub_root" ]] || error "$type has no public tier registered"

item_suffix=""; [[ "$shape" == "file" ]] && item_suffix=".md"
src="$pub_root/$name$item_suffix"
[[ -e "$src" ]] || error "No public $type at ${src#$repo_root/}"

mkdir -p "$wip_root" || error "Failed to create $wip_root"
slug=$(fetch_wip_slug "$wip_root" "$item_suffix") \
  || error "Could not find an unused fuzzed name after 5 attempts (or word-source API failed)"
dest="$wip_root/$slug$item_suffix"

if [[ "$shape" == "dir" ]]; then
  cp -R "$src" "$dest" || error "Failed to copy $src to $dest"
  sed -i.bak "s/^name: .*/name: $slug/" "$dest/SKILL.md" || error "Failed to rewrite name in $dest/SKILL.md"
  rm -f "$dest/SKILL.md.bak"

  claude_skills_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
  [[ -L "$claude_skills_dir/$name" ]] && rm "$claude_skills_dir/$name"
  mkdir -p "$claude_skills_dir" || error "Failed to create $claude_skills_dir"
  ln -s "$dest" "$claude_skills_dir/$slug" || error "Failed to symlink $slug into $claude_skills_dir"
else
  cp "$src" "$dest" || error "Failed to copy $src to $dest"
  # memory keeps its real name in frontmatter: only the filename is fuzzed
  if [[ -n "$wip_index" ]]; then
    echo -n "Title for the WIP index line: "
    read -r title
    echo -n "One-line hook: "
    read -r hook
    touch "$wip_index"
    print -r -- "- [$title]($slug.md): $hook" >> "$wip_index"
  fi
fi

rm -rf "$src"
[[ -n "$pub_index" && -f "$pub_index" ]] && {
  grep -vF "]($name$item_suffix)" "$pub_index" > "$pub_index.tmp" && mv "$pub_index.tmp" "$pub_index"
}

"$repo_root/shared/tools/encrypt" "$wip_root" "$enc_root" || error "Demoted but encrypt failed: run $type-encrypt manually"

success "Demoted $type '$name' to WIP as '$slug'"
