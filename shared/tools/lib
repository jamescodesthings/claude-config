#!/usr/bin/env zsh
# shared/tools/lib — Shared library for Agent Forge installers and tools

if [[ -n "${(%):-%x}" && "${(%):-%x}" != "zsh" ]]; then
  LIB_DIR="$(cd "$(dirname "${(%):-%x}")" >/dev/null 2>&1 && pwd)"
else
  LIB_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
fi
ROOT_DIR="$(cd "$LIB_DIR/../.." && pwd)"

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
GEMINI_DIR="${GEMINI_CONFIG_DIR:-$HOME/.gemini}"
ANTIGRAVITY_DIR="$GEMINI_DIR/antigravity-cli"

info()    { print -P "%F{blue}[info]%f:  $1" }
success() { print -P "%F{green}[ok]%f:    $1" }
warn()    { print -P "%F{yellow}[warn]%f:  $1" }
error()   { print -P "%F{red}[error]%f $1" && exit 1 }

symlink() {
  local src=$1 dest=$2
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    rm "$dest"
  elif [[ -e "$dest" ]]; then
    mv "$dest" "$dest.bak"
    warn "Backed up $dest → $dest.bak"
  fi
  if ! ln -s "$src" "$dest"; then
    error "Failed to link $dest"
    return 1
  fi
  success "Linked $(basename "$dest")"
}

clean_dead_symlinks() {
  local target_dir=$1
  [[ -d "$target_dir" ]] || return 0
  for f in "$target_dir"/*(N); do
    if [[ -L "$f" && ! -e "$f" ]]; then
      rm "$f"
      info "Removed dangling symlink: $f"
    elif [[ -d "$f" && ! -L "$f" ]]; then
      clean_dead_symlinks "$f"
    fi
  done
}

apply_manifest() {
  local manifest_file=$1
  [[ -f "$manifest_file" ]] || error "Manifest file $manifest_file not found"
  while IFS=':' read -r rel_src raw_dest || [[ -n "$rel_src" ]]; do
    [[ -z "$rel_src" || "$rel_src" == "#"* ]] && continue
    local abs_dest
    abs_dest=$(eval echo "$raw_dest")
    if [[ "$rel_src" == *"/*" ]]; then
      local base_rel="${rel_src%\/\*}"
      local base_abs="$ROOT_DIR/$base_rel"
      if [[ -d "$base_abs" ]]; then
        for f in "$base_abs"/*(N); do
          symlink "$f" "$abs_dest/$(basename "$f")"
        done
      fi
    else
      local abs_src="$ROOT_DIR/$rel_src"
      if [[ -e "$abs_src" ]]; then
        symlink "$abs_src" "$abs_dest"
      fi
    fi
  done < "$manifest_file"
}

# Fetches an unused two-word fuzzed slug under $1 (a wip root). $2 is the
# collision-check suffix appended to the candidate before testing for
# existence — "" for a directory-shaped item (skills), ".md" for a
# single-file item (memory). Retries up to 5 times against the word-source
# API. Prints the slug to stdout and returns 0, or prints nothing and
# returns 1 on failure.
#
# Callers invoke this via command substitution ($(fetch_wip_slug ...)), which
# runs in a subshell — so this must never call `error` (its `exit` would only
# kill the subshell, silently swallowed by the caller) and any diagnostic
# output must go to stderr, never stdout, or it corrupts the returned slug.
fetch_wip_slug() {
  local wip_root="$1" collision_suffix="$2"
  local resp candidate
  local -a words

  for _ in 1 2 3 4 5; do
    resp=$(curl -sf "https://random-word-api.herokuapp.com/word?number=2") || return 1
    words=("${(@f)$(print -r -- "$resp" | tr -d '[]"' | tr ',' '\n')}")
    [[ ${#words[@]} -eq 2 ]] || return 1
    candidate="${words[1]}-${words[2]}"
    if [[ ! -e "$wip_root/$candidate$collision_suffix" ]]; then
      print -r -- "$candidate"
      return 0
    fi
    warn "Slug $candidate already exists, retrying" >&2
  done
  return 1
}

# Looks up one content-type's config from shared/tools/wip-types. Prints
# "wip_root:encrypted_root:shape:public_root:public_index:wip_index" with
# paths resolved to absolute (empty fields stay empty). Returns 1 if the
# type isn't registered.
wip_type_config() {
  local type="$1"
  local types_file="${2:-$ROOT_DIR/shared/tools/wip-types}"
  local t wip enc shape pub pubidx wipidx
  while IFS=':' read -r t wip enc shape pub pubidx wipidx || [[ -n "$t" ]]; do
    [[ -z "$t" || "$t" == "#"* ]] && continue
    if [[ "$t" == "$type" ]]; then
      print -r -- "$ROOT_DIR/$wip:$ROOT_DIR/$enc:$shape:${pub:+$ROOT_DIR/$pub}:${pubidx:+$ROOT_DIR/$pubidx}:${wipidx:+$ROOT_DIR/$wipidx}"
      return 0
    fi
  done < "$types_file"
  return 1
}

load_env() {
  local env_file="${1:-$ROOT_DIR/.env}"
  [[ -f "$env_file" ]] || error "missing $env_file — run shared/tools/create-key first"
  set -a
  source "$env_file"
  set +a
  [[ -n "$SKILLS_ENCRYPTION_KEY" ]] && export SKILLS_ENCRYPTION_KEY
}

# Emits "<abs-wip-root> <abs-encrypted-root>" per line, one per registered
# content-type. Add a pair to shared/tools/wip-pairs to onboard a new one.
wip_pairs() {
  local pairs_file="${1:-$ROOT_DIR/shared/tools/wip-pairs}"
  [[ -f "$pairs_file" ]] || error "missing $pairs_file"
  local line wip enc
  while IFS=':' read -r wip enc || [[ -n "$wip" ]]; do
    [[ -z "$wip" || "$wip" == "#"* ]] && continue
    print -r -- "$ROOT_DIR/$wip $ROOT_DIR/$enc"
  done < "$pairs_file"
}
