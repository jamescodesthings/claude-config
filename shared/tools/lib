#!/usr/bin/env zsh
# shared/tools/lib: Shared library for Agent Forge installers and tools

if [[ -n "${(%):-%x}" && "${(%):-%x}" != "zsh" ]]; then
  LIB_DIR="$(cd "$(dirname "${(%):-%x}")" >/dev/null 2>&1 && pwd)"
else
  LIB_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
fi
ROOT_DIR="$(cd "$LIB_DIR/../.." && pwd)"

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
GEMINI_DIR="${GEMINI_CONFIG_DIR:-$HOME/.gemini}"
ANTIGRAVITY_DIR="$GEMINI_DIR/antigravity-cli"

# The colour prefix goes through print -P, the message never does. Paths reach
# these functions, and under prompt_subst `print -P` performs command
# substitution, so a file named `$(...)` inside a directory being cleaned would
# otherwise execute. prompt_subst is not set in this repo's script environment
# today, but it is one .zshenv edit away and the cost of being safe is nil.
info()    { print -Pn "%F{blue}[info]%f:  "; print -r -- "$1" }
success() { print -Pn "%F{green}[ok]%f:    "; print -r -- "$1" }
warn()    { print -Pn "%F{yellow}[warn]%f:  "; print -r -- "$1" }
error()   { print -Pn "%F{red}[error]%f "; print -r -- "$1"; exit 1 }

symlink() {
  local src=$1 dest=$2
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    rm "$dest"
  elif [[ -e "$dest" ]]; then
    mv "$dest" "$dest.bak"
    warn "Backed up $dest → $dest.bak"
  fi
  if ! ln -s "$src" "$dest"; then
    error "Failed to link $dest"
    return 1
  fi
  success "Linked $(basename "$dest")"
}

clean_dead_symlinks() {
  local target_dir=$1
  [[ -d "$target_dir" ]] || return 0
  for f in "$target_dir"/*(N); do
    if [[ -L "$f" && ! -e "$f" ]]; then
      rm "$f"
      info "Removed dangling symlink: $f"
    elif [[ -d "$f" && ! -L "$f" ]]; then
      clean_dead_symlinks "$f"
    fi
  done
}

apply_manifest() {
  local manifest_file=$1
  # Declared once, up here, rather than inside the loop. A bare `local name`
  # for a name that is already declared in scope behaves like `typeset name`
  # and echoes "name=value", which is where the stray `abs_dest=/Users/...`
  # lines in the installer output came from.
  local abs_dest abs_src base_rel base_abs dirs_only
  [[ -f "$manifest_file" ]] || error "Manifest file $manifest_file not found"
  while IFS=':' read -r rel_src raw_dest || [[ -n "$rel_src" ]]; do
    [[ -z "$rel_src" || "$rel_src" == "#"* ]] && continue
    abs_dest=$(eval echo "$raw_dest")
    # Two glob forms are supported:
    #   dir/*   link every entry (files and directories)
    #   dir/*/  link only subdirectories
    # The dirs-only form exists because shared/skills-wip/ holds a plugin.json
    # alongside the skill directories. Antigravity needs that file in its
    # skills dir to treat the tree as a plugin; Claude Code does not, and
    # linking it there produces a bogus non-skill entry.
    if [[ "$rel_src" == *"/*/" || "$rel_src" == *"/*" ]]; then
      dirs_only=0
      [[ "$rel_src" == *"/*/" ]] && dirs_only=1
      base_rel="${rel_src%/\*/}"
      base_rel="${base_rel%/\*}"
      base_abs="$ROOT_DIR/$base_rel"
      if [[ -d "$base_abs" ]]; then
        for f in "$base_abs"/*(N); do
          (( dirs_only )) && [[ ! -d "$f" ]] && continue
          symlink "$f" "$abs_dest/$(basename "$f")"
        done
      fi
    else
      abs_src="$ROOT_DIR/$rel_src"
      if [[ -e "$abs_src" ]]; then
        symlink "$abs_src" "$abs_dest"
      fi
    fi
  done < "$manifest_file"
}

# Fetches an unused two-word fuzzed slug under $1 (a wip root). $2 is the
# collision-check suffix appended to the candidate before testing for
# existence: "" for a directory-shaped item (skills), ".md" for a
# single-file item (memory). Retries up to 5 times against the word-source
# API. Prints the slug to stdout and returns 0, or prints nothing and
# returns 1 on failure.
#
# Callers invoke this via command substitution ($(fetch_wip_slug ...)), which
# runs in a subshell: so this must never call `error` (its `exit` would only
# kill the subshell, silently swallowed by the caller) and any diagnostic
# output must go to stderr, never stdout, or it corrupts the returned slug.
fetch_wip_slug() {
  local wip_root="$1" collision_suffix="$2"
  local resp candidate
  local -a words

  for _ in 1 2 3 4 5; do
    resp=$(curl -sf "https://random-word-api.herokuapp.com/word?number=2") || return 1
    words=("${(@f)$(print -r -- "$resp" | tr -d '[]"' | tr ',' '\n')}")
    [[ ${#words[@]} -eq 2 ]] || return 1
    candidate="${words[1]}-${words[2]}"
    if [[ ! -e "$wip_root/$candidate$collision_suffix" ]]; then
      print -r -- "$candidate"
      return 0
    fi
    warn "Slug $candidate already exists, retrying" >&2
  done
  return 1
}

# Looks up one content-type's config from shared/tools/wip-types. Prints
# "wip_root:encrypted_root:shape:public_root:public_index:wip_index" with
# paths resolved to absolute (empty fields stay empty). Returns 1 if the
# type isn't registered.
wip_type_config() {
  local type="$1"
  local types_file="${2:-$ROOT_DIR/shared/tools/wip-types}"
  local t wip enc shape pub pubidx wipidx
  while IFS=':' read -r t wip enc shape pub pubidx wipidx || [[ -n "$t" ]]; do
    [[ -z "$t" || "$t" == "#"* ]] && continue
    if [[ "$t" == "$type" ]]; then
      print -r -- "$ROOT_DIR/$wip:$ROOT_DIR/$enc:$shape:${pub:+$ROOT_DIR/$pub}:${pubidx:+$ROOT_DIR/$pubidx}:${wipidx:+$ROOT_DIR/$wipidx}"
      return 0
    fi
  done < "$types_file"
  return 1
}

load_env() {
  local env_file="${1:-$ROOT_DIR/.env}"
  [[ -f "$env_file" ]] || error "missing $env_file: run shared/tools/create-key first"
  set -a
  source "$env_file"
  set +a
  [[ -n "$SKILLS_ENCRYPTION_KEY" ]] && export SKILLS_ENCRYPTION_KEY
}

# Emits "<abs-wip-root> <abs-encrypted-root>" per line, one per registered
# content-type. Add a pair to shared/tools/wip-pairs to onboard a new one.
wip_pairs() {
  local pairs_file="${1:-$ROOT_DIR/shared/tools/wip-pairs}"
  [[ -f "$pairs_file" ]] || error "missing $pairs_file"
  local line wip enc
  while IFS=':' read -r wip enc || [[ -n "$wip" ]]; do
    [[ -z "$wip" || "$wip" == "#"* ]] && continue
    print -r -- "$ROOT_DIR/$wip $ROOT_DIR/$enc"
  done < "$pairs_file"
}

# Downloads a vendor install script into the repo's gitignored .cache/ and
# prints the path, instead of piping the URL straight into a shell. Same trust
# model either way (vendor URL, vendor script), but this leaves the exact bytes
# that ran on disk, auditable after the fact. Re-fetched on every run so the
# cache can never pin a stale installer.
#
# Called via $(...), so this runs in a subshell: never call `error` here (its
# exit would only kill the subshell) and keep diagnostics on stderr, or they
# corrupt the returned path.
fetch_installer() {
  local url="$1" name="$2"
  local cache_dir="$ROOT_DIR/.cache/installers"
  local dest="$cache_dir/$name.sh"
  mkdir -p "$cache_dir" || return 1
  # curl's own diagnostics ("curl: (56) ... 403") belong in the run log with
  # the rest of the third-party output, not on the console next to this repo's
  # formatting. run_log_dir may not be available (unwritable .cache), in which
  # case the console is still better than nothing.
  local log_dir download_log
  if log_dir=$(run_log_dir); then
    download_log="$log_dir/downloads.log"
    print -r -- "=== $(date '+%H:%M:%S') \$ curl $url" >> "$download_log"
  else
    download_log=/dev/stderr
  fi
  local from=$(( $(_line_count "$download_log") ))
  curl -fsSL "$url" -o "$dest.tmp" 2>> "$download_log"
  local curl_rc=$?
  # The same exit trailer run_logged writes. Without it, consecutive attempts
  # in downloads.log run together with no way to see where one ended.
  if [[ "$download_log" != /dev/stderr ]]; then
    end_with_newline "$download_log"
    print -r -- "=== exit $curl_rc" >> "$download_log"
  fi
  if (( curl_rc != 0 )); then
    warn "Failed to download $name installer from $url. Full log: $download_log" >&2
    # Same treatment as a failed run_logged step: say why, not just that.
    [[ "$download_log" == /dev/stderr ]] || log_tail "$download_log" "$from" >&2
    rm -f "$dest.tmp"
    return 1
  fi
  # A truncated download or an HTML error page served with a 200 is worse than
  # no download at all, because the next line would execute it.
  if [[ ! -s "$dest.tmp" ]] || ! head -1 "$dest.tmp" | grep -q '^#!'; then
    warn "Downloaded $name installer is not a shell script, refusing to run it" >&2
    rm -f "$dest.tmp"
    return 1
  fi
  mv "$dest.tmp" "$dest" || return 1
  chmod +x "$dest"
  print -r -- "$dest"
}

# Runs a command with a wall-clock cap when coreutils' timeout is available.
# macOS ships no `timeout`, so without gtimeout this is a plain passthrough:
# the guard is a nice-to-have, never a dependency.
run_guarded() {
  local seconds="$1"; shift
  if command -v gtimeout &> /dev/null; then
    gtimeout "$seconds" "$@"
  else
    "$@"
  fi
}

# Deletes a path and reports it, skipping anything already gone. Globs are the
# caller's job: pass expanded paths.
purge_path() {
  local target="$1"
  [[ -e "$target" || -L "$target" ]] || return 0
  # `--` so a target beginning with a dash is a path, never a flag.
  rm -rf -- "$target" && info "Purged $target"
}

# Prints every path a purge is about to delete and requires a typed
# confirmation. Returns 0 to proceed, 1 to skip. Set AGENT_FORGE_ASSUME_YES=1
# (or pass --yes to the uninstaller) to skip the prompt; a non-interactive
# shell without that variable always refuses, so an unattended run can never
# wipe a machine by accident.
#
# Paths that do not exist are filtered out first, so the list shown is exactly
# what will go.
confirm_purge() {
  local label="$1"; shift
  local -a present
  local p
  for p in "$@"; do
    [[ -e "$p" || -L "$p" ]] && present+=("$p")
  done
  if (( ${#present[@]} == 0 )); then
    info "Nothing to purge for $label"
    return 1
  fi
  # Prefix through -P, message through -r, same as info/warn/success/error.
  # The labels passed today are literals, but this is the one spot in the purge
  # path still shaped like the prompt_subst hazard the log functions avoid.
  print -Pn "%F{yellow}[warn]%f:  "
  print -r -- "About to permanently delete $label:"
  for p in $present; do
    print -r -- "           $p"
  done
  # Set but falsey means no. `AGENT_FORGE_ASSUME_YES=0` reading as yes is the
  # kind of surprise that only surfaces once, destructively.
  case "${AGENT_FORGE_ASSUME_YES:-}" in
    ""|0|no|false|off) ;;
    *) return 0 ;;
  esac
  if [[ ! -t 0 ]]; then
    warn "Not an interactive shell and AGENT_FORGE_ASSUME_YES is unset: skipping purge"
    return 1
  fi
  local reply
  print -n -P "%F{yellow}[warn]%f:  Type 'purge' to confirm: "
  read -r reply
  [[ "$reply" == "purge" ]] && return 0
  info "Purge skipped"
  return 1
}

# Refuses a config root that is unsafe to hand to rm -rf. Prints the normalised
# path and returns 0, or explains the refusal on stderr and returns 1.
#
# CLAUDE_CONFIG_DIR and GEMINI_CONFIG_DIR come from the ambient environment and
# feed straight into the purge. Every check below closes a route an adversarial
# review found from "someone set that variable oddly" to "the wrong tree is
# gone". Called via $(...), so diagnostics go to stderr and it never calls
# `error`, whose exit would only kill the subshell.
validate_purge_root() {
  local label="$1" path="$2"
  if [[ -z "$path" ]]; then
    warn "$label is empty, refusing to touch anything" >&2
    return 1
  fi
  # A trailing slash makes the kernel resolve through a symlink before lstat
  # returns, so rm descends into the target and empties it instead of unlinking
  # the link. Strip trailing slashes before anything else reads the path.
  while [[ "$path" == */ && "$path" != "/" ]]; do
    path="${path%/}"
  done
  if [[ "$path" != /* ]]; then
    warn "$label is not absolute ($path): it would resolve against the caller's working directory" >&2
    return 1
  fi
  if [[ "$path" == "/" || "$path" == "$HOME" ]]; then
    warn "$label resolves to $path, refusing" >&2
    return 1
  fi
  # A real config root is never a top-level directory.
  if [[ "${path:h}" == "/" ]]; then
    warn "$label ($path) is a top-level directory, refusing" >&2
    return 1
  fi
  # Deleting an ancestor of the repo would take this tool's own source with it.
  if [[ "$ROOT_DIR" == "$path" || "$ROOT_DIR" == "$path"/* ]]; then
    warn "$label ($path) contains the agent-forge repo, refusing" >&2
    return 1
  fi
  print -r -- "$path"
}

# ---------------------------------------------------------------------------
# Run logging
# ---------------------------------------------------------------------------
# Third-party installers write in their own formatting: vendor bootstrappers,
# `claude plugin install`, npx, uv and brew all emit banners, spinners and
# progress bars that drown out this repo's own output. The previous fix was
# `&> /dev/null`, which cured the noise by destroying the evidence: when a step
# failed, the warning said that it had failed and nothing anywhere said why.
#
# run_logged captures both streams to a per-run log file instead. Console stays
# quiet, the full output lands on disk, and a tail of it is printed inline when
# the step returns non-zero. --debug streams it live as well, --trace adds
# shell tracing on top.

AGENT_FORGE_LOG_ROOT="$ROOT_DIR/.cache/logs"
AGENT_FORGE_LOG_TAIL_LINES="${AGENT_FORGE_LOG_TAIL_LINES:-20}"
AGENT_FORGE_LOG_KEEP_RUNS="${AGENT_FORGE_LOG_KEEP_RUNS:-10}"

# One log directory per install run, shared by every script in it. Exported so
# sub-installers, which are separate processes, land in the same directory as
# the master installer that spawned them. A sub-installer run on its own gets
# its own run id.
if [[ -z "$AGENT_FORGE_RUN_ID" ]]; then
  export AGENT_FORGE_RUN_ID="$(date +%Y-%m-%d-%H-%M-%S)-$$"
  # Whoever minted the id owns the run. Sub-installers inherit both, and only
  # the owner reports the log location at the end, so `./install` says where
  # the logs are once rather than three times.
  export AGENT_FORGE_RUN_OWNER="$$"
fi

# Both flags follow the AGENT_FORGE_ASSUME_YES convention: set but falsey means
# off, so `AGENT_FORGE_DEBUG=0` cannot read as on.
_flag_enabled() {
  case "${1:-}" in
    ""|0|no|false|off) return 1 ;;
    *) return 0 ;;
  esac
}

debug_enabled() { _flag_enabled "${AGENT_FORGE_DEBUG:-}" }
trace_enabled() { _flag_enabled "${AGENT_FORGE_TRACE:-}" }

# Tracing is switched on with the two-token idiom
#
#   trace_enabled && setopt xtrace
#
# rather than a helper function that does both, because zsh saves and restores
# the xtrace option across every function call: a `setopt xtrace` inside a
# function is silently undone the moment that function returns. At the top
# level of a sourced file or a script it persists, which is where both uses of
# this idiom live.
PS4='+%N:%i> '

# Parses the shared debug arguments out of an entry point's argv. Returns 0 if
# the argument was consumed, 1 if the caller should handle it itself.
parse_debug_arg() {
  case "$1" in
    --debug|-d) export AGENT_FORGE_DEBUG=1; return 0 ;;
    # --trace implies --debug: shell tracing with the command output still
    # hidden would show the call and not its result.
    --trace)    export AGENT_FORGE_DEBUG=1 AGENT_FORGE_TRACE=1; return 0 ;;
    *) return 1 ;;
  esac
}

# prune_run_logs deletes with rm -rf, so the log root gets the same kind of
# proof-before-deleting that validate_purge_root gives CLAUDE_CONFIG_DIR.
#
# ROOT_DIR is derived from this file's own location, which is normally
# airtight. The gap is a `cd` that succeeds against a broken path: an empty
# LIB_DIR makes `cd "/../.."` resolve to `/` and exit 0, at which point
# AGENT_FORGE_LOG_ROOT is `/.cache/logs`, unrelated to this repo. macOS refuses
# to create that, so the failure is inert here; a root-run Linux container is a
# different story.
validate_log_root() {
  [[ -n "$ROOT_DIR" && "$ROOT_DIR" != "/" ]] || return 1
  # Only the directory this library actually lives in counts as the repo.
  [[ -f "$ROOT_DIR/shared/tools/lib" ]] || return 1
  [[ "$AGENT_FORGE_LOG_ROOT" == "$ROOT_DIR/.cache/logs" ]] || return 1
  return 0
}

# Absolute path of this run's log directory, created on first use. Prints
# nothing and returns 1 if it cannot be created: logging is a convenience and
# never a reason to fail an install.
run_log_dir() {
  validate_log_root || return 1
  local dir="$AGENT_FORGE_LOG_ROOT/$AGENT_FORGE_RUN_ID"
  mkdir -p "$dir" 2>/dev/null || return 1
  # `latest` is what you actually want to open after a failed run.
  ln -sfn "$AGENT_FORGE_RUN_ID" "$AGENT_FORGE_LOG_ROOT/latest" 2>/dev/null
  print -r -- "$dir"
}

# log_tail <file> [start_line] [max_lines]
#
# Prints the tail of a log file, one indented line at a time, optionally from a
# given line onward. The start offset is what keeps a failure report scoped to
# the step that just failed: log files are appended to across every command a
# script runs, so a plain tail of the file would show the previous step's
# output alongside this one's.
#
# `print -r` per line because log content is third-party text: a line
# containing a prompt escape or a command substitution must never be
# interpreted.
log_tail() {
  local file="$1" start="${2:-1}" max="${3:-$AGENT_FORGE_LOG_TAIL_LINES}" line
  [[ -s "$file" ]] || { print -r -- "           (log is empty)"; return 0 }
  tail -n "+$start" "$file" 2>/dev/null | tail -n "$max" | while IFS= read -r line; do
    print -r -- "           $line"
  done
}

# Appends a newline if the file does not already end with one. Plenty of CLIs
# finish on a progress line with no trailing newline, and without this the
# "=== exit N" footer is glued onto the end of that line: invisible to a human
# skimming the log and invisible to a `grep '^=== exit'`.
end_with_newline() {
  local file="$1"
  [[ -s "$file" ]] || return 0
  [[ -n "$(tail -c 1 "$file")" ]] && print -r -- "" >> "$file"
  return 0
}

# Line count of a file, 0 if it does not exist yet.
_line_count() {
  [[ -f "$1" ]] || { print -r -- 0; return 0 }
  local n
  n=$(wc -l < "$1" 2>/dev/null) || n=0
  print -r -- "${n// /}"
}

# run_logged <label> <command> [args...]
#
# Runs the command with stdin closed and both output streams captured to
# .cache/logs/<run-id>/<label>.log, appending so every step a script runs ends
# up in one readable file. Returns the command's own exit status, so the usual
# `run_logged x foo || warn ...` idiom is unchanged.
#
# The log path is left in $LAST_RUN_LOG, which is how a caller gets at the
# output afterwards (grep it for a version string, re-tail it, report it).
#
# There is no locking, and appends from two processes to the same log file
# interleave mid-line rather than mid-file. Nothing here needs a lock today:
# the run id carries the entry point's PID, so two concurrent `./install` runs
# get separate directories, and within one run every sub-installer is invoked
# sequentially. Anything that breaks either of those (backgrounding the
# tool_script loop, or a wrapper exporting a fixed AGENT_FORGE_RUN_ID across
# parallel invocations) needs a lock added here first, because the per-step
# `from` offset below is computed per process and cannot see another writer.
#
# stdin is closed on purpose. An installer dropping into a TUI prompt that
# nobody can see, because its output is captured, is exactly the bug that
# wedged `make install` at the caveman step; there is no case here where a
# third-party installer should be reading this terminal.
run_logged() {
  local label="$1"; shift
  local safe="${label//[^A-Za-z0-9._-]/_}"
  # `rc`, not `status`: $status is a zsh special parameter aliased to $? and is
  # read-only, so `local status` is a runtime error, not a syntax one.
  local dir file rc

  if ! dir=$(run_log_dir); then
    warn "Could not create log directory under $AGENT_FORGE_LOG_ROOT, running unlogged"
    # Cleared, not left alone. A caller that reports "$LAST_RUN_LOG" on failure
    # would otherwise point the reader at an earlier, unrelated, probably
    # successful step's log while this step's output went nowhere at all.
    typeset -g LAST_RUN_LOG=""
    "$@" < /dev/null
    return $?
  fi

  file="$dir/$safe.log"
  typeset -g LAST_RUN_LOG="$file"
  # Where this step's output starts, so a failure report can show this step
  # rather than everything the script has run so far.
  local from=$(( $(_line_count "$file") + 1 ))
  print -r -- "=== $(date '+%H:%M:%S') \$ $*" >> "$file"

  if debug_enabled; then
    "$@" < /dev/null 2>&1 | tee -a "$file"
    rc=${pipestatus[1]}
  else
    "$@" < /dev/null >> "$file" 2>&1
    rc=$?
  fi

  # The tail is taken before the exit marker is appended, so a failure report
  # spends all its lines on output rather than one on its own footer.
  if (( rc != 0 )) && ! debug_enabled; then
    warn "$label failed (exit $rc), last $AGENT_FORGE_LOG_TAIL_LINES lines below. Full log: $file"
    log_tail "$file" "$from"
  elif (( rc != 0 )); then
    warn "$label failed (exit $rc), see $file"
  fi

  end_with_newline "$file"
  print -r -- "=== exit $rc" >> "$file"
  return $rc
}

# Keeps the last AGENT_FORGE_LOG_KEEP_RUNS run directories. Called by the entry
# point installers once the run is done; the run ids sort chronologically
# because they are timestamps.
prune_run_logs() {
  validate_log_root || return 0
  [[ -d "$AGENT_FORGE_LOG_ROOT" ]] || return 0
  local -a runs
  # (/) directories only, (On) newest first (the run ids are timestamps, so a
  # descending name sort is a descending time sort), (^@) not symlinks so the
  # `latest` link is never a deletion candidate.
  #
  # Qualifier order matters and is not cosmetic: `^` inverts the sense of every
  # qualifier that follows it, so the obvious-looking (N/^@On) negates the sort
  # as well as the symlink test and hands back the OLDEST runs to keep. Keep
  # `^@` last. Ascending order here would delete the newest runs and keep the
  # stale ones.
  runs=("$AGENT_FORGE_LOG_ROOT"/*(N/On^@))
  (( ${#runs[@]} > AGENT_FORGE_LOG_KEEP_RUNS )) || return 0
  local stale
  for stale in "${runs[@]:$AGENT_FORGE_LOG_KEEP_RUNS}"; do
    # Never the run currently being written, whatever the sort says.
    [[ "${stale:t}" == "$AGENT_FORGE_RUN_ID" ]] && continue
    rm -rf -- "$stale"
  done
}

# Reports where this run's output went. Entry points call this at the end so
# the path is on screen whether or not anything failed.
report_log_location() {
  [[ -d "$AGENT_FORGE_LOG_ROOT/$AGENT_FORGE_RUN_ID" ]] || return 0
  # Sub-installers stay quiet unless they were the entry point.
  [[ "$AGENT_FORGE_RUN_OWNER" == "$$" ]] || return 0
  info "Full installer output: $AGENT_FORGE_LOG_ROOT/$AGENT_FORGE_RUN_ID (also linked as $AGENT_FORGE_LOG_ROOT/latest)"
  debug_enabled || info "Re-run with --debug to stream it live, or --trace to add shell tracing."
}

# Best-effort version string for a CLI, for the success messages. Never fails:
# a CLI that cannot report its own version is not a reason to fail an install.
cli_version() {
  local bin="$1" line
  line=$("$bin" --version 2>/dev/null | head -1)
  line="${line//$'\r'/}"
  [[ -z "$line" ]] && { print -r -- "version unknown"; return 0 }
  print -r -- "$(version_token "$line")"
}

# Pulls the first dotted-numeric token out of a version line. CLIs pad
# --version with their own name and a build tag ("rtk 0.45.0", "2.1.237 (Claude
# Code)"), which is noise in a one-line success message and produces things
# like "rtk up to date (rtk 0.45.0)". Falls back to the whole line when there
# is nothing version-shaped in it.
version_token() {
  local line="$1"
  if [[ "$line" =~ '[0-9]+(\.[0-9]+)+' ]]; then
    print -r -- "$MATCH"
  else
    print -r -- "$line"
  fi
}

# A trace flag inherited from a parent process applies from here on. Entry
# points repeat this after parsing their own --trace.
#
# The if-form rather than `trace_enabled && setopt xtrace` only because this is
# the last line of the file: the bare form would make `source lib` itself
# return non-zero whenever tracing is off.
if trace_enabled; then
  setopt xtrace
fi
