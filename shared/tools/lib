#!/usr/bin/env zsh
# shared/tools/lib: Shared library for Agent Forge installers and tools

if [[ -n "${(%):-%x}" && "${(%):-%x}" != "zsh" ]]; then
  LIB_DIR="$(cd "$(dirname "${(%):-%x}")" >/dev/null 2>&1 && pwd)"
else
  LIB_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
fi
ROOT_DIR="$(cd "$LIB_DIR/../.." && pwd)"

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
GEMINI_DIR="${GEMINI_CONFIG_DIR:-$HOME/.gemini}"
ANTIGRAVITY_DIR="$GEMINI_DIR/antigravity-cli"

# The colour prefix goes through print -P, the message never does. Paths reach
# these functions, and under prompt_subst `print -P` performs command
# substitution, so a file named `$(...)` inside a directory being cleaned would
# otherwise execute. prompt_subst is not set in this repo's script environment
# today, but it is one .zshenv edit away and the cost of being safe is nil.
info()    { print -Pn "%F{blue}[info]%f:  "; print -r -- "$1" }
success() { print -Pn "%F{green}[ok]%f:    "; print -r -- "$1" }
warn()    { print -Pn "%F{yellow}[warn]%f:  "; print -r -- "$1" }
error()   { print -Pn "%F{red}[error]%f "; print -r -- "$1"; exit 1 }

symlink() {
  local src=$1 dest=$2
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    rm "$dest"
  elif [[ -e "$dest" ]]; then
    mv "$dest" "$dest.bak"
    warn "Backed up $dest → $dest.bak"
  fi
  if ! ln -s "$src" "$dest"; then
    error "Failed to link $dest"
    return 1
  fi
  success "Linked $(basename "$dest")"
}

clean_dead_symlinks() {
  local target_dir=$1
  [[ -d "$target_dir" ]] || return 0
  for f in "$target_dir"/*(N); do
    if [[ -L "$f" && ! -e "$f" ]]; then
      rm "$f"
      info "Removed dangling symlink: $f"
    elif [[ -d "$f" && ! -L "$f" ]]; then
      clean_dead_symlinks "$f"
    fi
  done
}

apply_manifest() {
  local manifest_file=$1
  # Declared once, up here, rather than inside the loop. A bare `local name`
  # for a name that is already declared in scope behaves like `typeset name`
  # and echoes "name=value", which is where the stray `abs_dest=/Users/...`
  # lines in the installer output came from.
  local abs_dest abs_src base_rel base_abs dirs_only
  [[ -f "$manifest_file" ]] || error "Manifest file $manifest_file not found"
  while IFS=':' read -r rel_src raw_dest || [[ -n "$rel_src" ]]; do
    [[ -z "$rel_src" || "$rel_src" == "#"* ]] && continue
    abs_dest=$(eval echo "$raw_dest")
    # Two glob forms are supported:
    #   dir/*   link every entry (files and directories)
    #   dir/*/  link only subdirectories
    # The dirs-only form exists because shared/skills-wip/ holds a plugin.json
    # alongside the skill directories. Antigravity needs that file in its
    # skills dir to treat the tree as a plugin; Claude Code does not, and
    # linking it there produces a bogus non-skill entry.
    if [[ "$rel_src" == *"/*/" || "$rel_src" == *"/*" ]]; then
      dirs_only=0
      [[ "$rel_src" == *"/*/" ]] && dirs_only=1
      base_rel="${rel_src%/\*/}"
      base_rel="${base_rel%/\*}"
      base_abs="$ROOT_DIR/$base_rel"
      if [[ -d "$base_abs" ]]; then
        for f in "$base_abs"/*(N); do
          (( dirs_only )) && [[ ! -d "$f" ]] && continue
          symlink "$f" "$abs_dest/$(basename "$f")"
        done
      fi
    else
      abs_src="$ROOT_DIR/$rel_src"
      if [[ -e "$abs_src" ]]; then
        symlink "$abs_src" "$abs_dest"
      fi
    fi
  done < "$manifest_file"
}

# Fetches an unused two-word fuzzed slug under $1 (a wip root). $2 is the
# collision-check suffix appended to the candidate before testing for
# existence: "" for a directory-shaped item (skills), ".md" for a
# single-file item (memory). Retries up to 5 times against the word-source
# API. Prints the slug to stdout and returns 0, or prints nothing and
# returns 1 on failure.
#
# Callers invoke this via command substitution ($(fetch_wip_slug ...)), which
# runs in a subshell: so this must never call `error` (its `exit` would only
# kill the subshell, silently swallowed by the caller) and any diagnostic
# output must go to stderr, never stdout, or it corrupts the returned slug.
fetch_wip_slug() {
  local wip_root="$1" collision_suffix="$2"
  local resp candidate
  local -a words

  for _ in 1 2 3 4 5; do
    resp=$(curl -sf "https://random-word-api.herokuapp.com/word?number=2") || return 1
    words=("${(@f)$(print -r -- "$resp" | tr -d '[]"' | tr ',' '\n')}")
    [[ ${#words[@]} -eq 2 ]] || return 1
    candidate="${words[1]}-${words[2]}"
    if [[ ! -e "$wip_root/$candidate$collision_suffix" ]]; then
      print -r -- "$candidate"
      return 0
    fi
    warn "Slug $candidate already exists, retrying" >&2
  done
  return 1
}

# Looks up one content-type's config from shared/tools/wip-types. Prints
# "wip_root:encrypted_root:shape:public_root:public_index:wip_index" with
# paths resolved to absolute (empty fields stay empty). Returns 1 if the
# type isn't registered.
wip_type_config() {
  local type="$1"
  local types_file="${2:-$ROOT_DIR/shared/tools/wip-types}"
  local t wip enc shape pub pubidx wipidx
  while IFS=':' read -r t wip enc shape pub pubidx wipidx || [[ -n "$t" ]]; do
    [[ -z "$t" || "$t" == "#"* ]] && continue
    if [[ "$t" == "$type" ]]; then
      print -r -- "$ROOT_DIR/$wip:$ROOT_DIR/$enc:$shape:${pub:+$ROOT_DIR/$pub}:${pubidx:+$ROOT_DIR/$pubidx}:${wipidx:+$ROOT_DIR/$wipidx}"
      return 0
    fi
  done < "$types_file"
  return 1
}

load_env() {
  local env_file="${1:-$ROOT_DIR/.env}"
  [[ -f "$env_file" ]] || error "missing $env_file: run shared/tools/create-key first"
  set -a
  source "$env_file"
  set +a
  [[ -n "$SKILLS_ENCRYPTION_KEY" ]] && export SKILLS_ENCRYPTION_KEY
}

# Emits "<abs-wip-root> <abs-encrypted-root>" per line, one per registered
# content-type. Add a pair to shared/tools/wip-pairs to onboard a new one.
wip_pairs() {
  local pairs_file="${1:-$ROOT_DIR/shared/tools/wip-pairs}"
  [[ -f "$pairs_file" ]] || error "missing $pairs_file"
  local line wip enc
  while IFS=':' read -r wip enc || [[ -n "$wip" ]]; do
    [[ -z "$wip" || "$wip" == "#"* ]] && continue
    print -r -- "$ROOT_DIR/$wip $ROOT_DIR/$enc"
  done < "$pairs_file"
}

# Downloads a vendor install script into the repo's gitignored .cache/ and
# prints the path, instead of piping the URL straight into a shell. Same trust
# model either way (vendor URL, vendor script), but this leaves the exact bytes
# that ran on disk, auditable after the fact. Re-fetched on every run so the
# cache can never pin a stale installer.
#
# Called via $(...), so this runs in a subshell: never call `error` here (its
# exit would only kill the subshell) and keep diagnostics on stderr, or they
# corrupt the returned path.
fetch_installer() {
  local url="$1" name="$2"
  local cache_dir="$ROOT_DIR/.cache/installers"
  local dest="$cache_dir/$name.sh"
  mkdir -p "$cache_dir" || return 1
  if ! curl -fsSL "$url" -o "$dest.tmp"; then
    warn "Failed to download $name installer from $url" >&2
    rm -f "$dest.tmp"
    return 1
  fi
  # A truncated download or an HTML error page served with a 200 is worse than
  # no download at all, because the next line would execute it.
  if [[ ! -s "$dest.tmp" ]] || ! head -1 "$dest.tmp" | grep -q '^#!'; then
    warn "Downloaded $name installer is not a shell script, refusing to run it" >&2
    rm -f "$dest.tmp"
    return 1
  fi
  mv "$dest.tmp" "$dest" || return 1
  chmod +x "$dest"
  print -r -- "$dest"
}

# Runs a command with a wall-clock cap when coreutils' timeout is available.
# macOS ships no `timeout`, so without gtimeout this is a plain passthrough:
# the guard is a nice-to-have, never a dependency.
run_guarded() {
  local seconds="$1"; shift
  if command -v gtimeout &> /dev/null; then
    gtimeout "$seconds" "$@"
  else
    "$@"
  fi
}

# Deletes a path and reports it, skipping anything already gone. Globs are the
# caller's job: pass expanded paths.
purge_path() {
  local target="$1"
  [[ -e "$target" || -L "$target" ]] || return 0
  # `--` so a target beginning with a dash is a path, never a flag.
  rm -rf -- "$target" && info "Purged $target"
}

# Prints every path a purge is about to delete and requires a typed
# confirmation. Returns 0 to proceed, 1 to skip. Set AGENT_FORGE_ASSUME_YES=1
# (or pass --yes to the uninstaller) to skip the prompt; a non-interactive
# shell without that variable always refuses, so an unattended run can never
# wipe a machine by accident.
#
# Paths that do not exist are filtered out first, so the list shown is exactly
# what will go.
confirm_purge() {
  local label="$1"; shift
  local -a present
  local p
  for p in "$@"; do
    [[ -e "$p" || -L "$p" ]] && present+=("$p")
  done
  if (( ${#present[@]} == 0 )); then
    info "Nothing to purge for $label"
    return 1
  fi
  print -P "%F{yellow}[warn]%f:  About to permanently delete $label:"
  for p in $present; do
    print -r -- "           $p"
  done
  # Set but falsey means no. `AGENT_FORGE_ASSUME_YES=0` reading as yes is the
  # kind of surprise that only surfaces once, destructively.
  case "${AGENT_FORGE_ASSUME_YES:-}" in
    ""|0|no|false|off) ;;
    *) return 0 ;;
  esac
  if [[ ! -t 0 ]]; then
    warn "Not an interactive shell and AGENT_FORGE_ASSUME_YES is unset: skipping purge"
    return 1
  fi
  local reply
  print -n -P "%F{yellow}[warn]%f:  Type 'purge' to confirm: "
  read -r reply
  [[ "$reply" == "purge" ]] && return 0
  info "Purge skipped"
  return 1
}

# Refuses a config root that is unsafe to hand to rm -rf. Prints the normalised
# path and returns 0, or explains the refusal on stderr and returns 1.
#
# CLAUDE_CONFIG_DIR and GEMINI_CONFIG_DIR come from the ambient environment and
# feed straight into the purge. Every check below closes a route an adversarial
# review found from "someone set that variable oddly" to "the wrong tree is
# gone". Called via $(...), so diagnostics go to stderr and it never calls
# `error`, whose exit would only kill the subshell.
validate_purge_root() {
  local label="$1" path="$2"
  if [[ -z "$path" ]]; then
    warn "$label is empty, refusing to touch anything" >&2
    return 1
  fi
  # A trailing slash makes the kernel resolve through a symlink before lstat
  # returns, so rm descends into the target and empties it instead of unlinking
  # the link. Strip trailing slashes before anything else reads the path.
  while [[ "$path" == */ && "$path" != "/" ]]; do
    path="${path%/}"
  done
  if [[ "$path" != /* ]]; then
    warn "$label is not absolute ($path): it would resolve against the caller's working directory" >&2
    return 1
  fi
  if [[ "$path" == "/" || "$path" == "$HOME" ]]; then
    warn "$label resolves to $path, refusing" >&2
    return 1
  fi
  # A real config root is never a top-level directory.
  if [[ "${path:h}" == "/" ]]; then
    warn "$label ($path) is a top-level directory, refusing" >&2
    return 1
  fi
  # Deleting an ancestor of the repo would take this tool's own source with it.
  if [[ "$ROOT_DIR" == "$path" || "$ROOT_DIR" == "$path"/* ]]; then
    warn "$label ($path) contains the agent-forge repo, refusing" >&2
    return 1
  fi
  print -r -- "$path"
}
