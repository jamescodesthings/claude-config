#!/usr/bin/env zsh
# Scaffolds a new WIP skill under a fuzzed, meaningless folder name and
# symlinks it live into ~/.claude/skills for immediate testing.
repo_root="${0:A:h}/../.."
source "$repo_root/shared/tools/lib"

wip_root="$repo_root/shared/skills-wip"
claude_skills_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"

slug=$(fetch_wip_slug "$wip_root" "") || error "Could not find an unused fuzzed name after 5 attempts (or word-source API failed)"

echo -n "Description for this skill: "
read -r description

skill_dir="$wip_root/$slug"
mkdir -p "$skill_dir" || error "Failed to create $skill_dir"
cat > "$skill_dir/SKILL.md" <<EOF || error "Failed to write $skill_dir/SKILL.md"
---
name: $slug
description: $description
---

# $slug

EOF

mkdir -p "$claude_skills_dir" || error "Failed to create $claude_skills_dir"
ln -s "$skill_dir" "$claude_skills_dir/$slug" || error "Failed to symlink $slug into $claude_skills_dir"

success "Created WIP skill at shared/skills-wip/$slug, symlinked into $claude_skills_dir/$slug"
