#!/usr/bin/env zsh
# Moves a finished WIP memory to the plaintext, committed shared/memory/
# directory. Never automatic — requires explicit confirmation naming both the
# fuzzed slug and the destination filename.
repo_root="${0:A:h}/.."
source "$repo_root/tools/lib"

fuzzed_slug="$1"
real_name="$2"

[[ -n "$fuzzed_slug" && -n "$real_name" ]] \
  || error "Usage: graduate-memory <fuzzed-slug> <real-name>"

[[ "$fuzzed_slug" =~ '^[a-z0-9][a-z0-9-]*$' ]] \
  || error "Invalid fuzzed slug — must match [a-z0-9-]"
[[ "$real_name" =~ '^[a-z0-9][a-z0-9_-]*$' ]] \
  || error "Invalid real name — must match [a-z0-9_-]"

wip_root="$repo_root/shared/memory-wip"
src_file="$wip_root/$fuzzed_slug.md"
index_file="$wip_root/MEMORY-WIP.md"
[[ -f "$src_file" ]] || error "No WIP memory at shared/memory-wip/$fuzzed_slug.md"

dest_file="$repo_root/shared/memory/$real_name.md"
[[ -f "$dest_file" ]] && error "shared/memory/$real_name.md already exists"

echo -n "Graduate shared/memory-wip/$fuzzed_slug.md to shared/memory/$real_name.md — the file becomes plaintext in a public repo. Confirm? [y/N] "
read -r confirm
[[ "$confirm" == "y" || "$confirm" == "Y" ]] || error "Aborted"

cp "$src_file" "$dest_file" || error "Failed to copy $src_file to $dest_file"
sed -i.bak "s/^name: .*/name: $real_name/" "$dest_file" || error "Failed to rewrite name in $dest_file"
rm -f "$dest_file.bak"

echo -n "Title for the public MEMORY.md index line: "
read -r title
echo -n "One-line hook: "
read -r hook
print -r -- "- [$title]($real_name.md) — $hook" >> "$repo_root/shared/memory/MEMORY.md"

rm -f "$src_file"
[[ -f "$index_file" ]] && grep -v "]($fuzzed_slug.md)" "$index_file" > "$index_file.tmp" && mv "$index_file.tmp" "$index_file"
rm -f "$repo_root/shared/memory-encrypted/$fuzzed_slug.md"

success "Graduated shared/memory-wip/$fuzzed_slug.md to shared/memory/$real_name.md"
