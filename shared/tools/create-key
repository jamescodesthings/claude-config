#!/usr/bin/env zsh
# Generates a new symmetric encryption key, backs up the current .env, writes a new one.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
source "$SCRIPT_DIR/lib"

env_file="$ROOT_DIR/.env"

# The tmp/bak files below hold the new key in plaintext. Remove them on any
# exit path so an aborted run never leaves key material lying around untracked.
cleanup() { rm -f "$env_file.tmp" "$env_file.tmp.bak" }
trap cleanup EXIT INT TERM

new_key=$(openssl rand -base64 32)

umask 077

if [[ -f "$env_file" ]]; then
  n=1
  while [[ -f "$env_file.$n" ]]; do
    n=$((n + 1))
  done
  cp "$env_file" "$env_file.$n" || error "Failed to back up .env"
  chmod 600 "$env_file.$n"
  info "Backed up existing .env to .env.$n"
  cp "$env_file" "$env_file.tmp" || error "Failed to stage new .env"
else
  : > "$env_file.tmp"
fi

chmod 600 "$env_file.tmp"

if grep -q '^SKILLS_ENCRYPTION_KEY=' "$env_file.tmp" 2>/dev/null; then
  sed -i.bak "s#^SKILLS_ENCRYPTION_KEY=.*#SKILLS_ENCRYPTION_KEY=$new_key#" "$env_file.tmp"
  rm -f "$env_file.tmp.bak"
  grep -qF "SKILLS_ENCRYPTION_KEY=$new_key" "$env_file.tmp" \
    || error "Failed to write new key into $env_file.tmp (sed substitution did not take effect)"
else
  print -r -- "SKILLS_ENCRYPTION_KEY=$new_key" >> "$env_file.tmp"
fi

mv "$env_file.tmp" "$env_file" || error "Failed to move new .env into place"
chmod 600 "$env_file" || error "Failed to restrict permissions on .env"
trap - EXIT INT TERM
success "New encryption key written to .env"
