#!/usr/bin/env zsh
# Scaffolds a new WIP memory file under a fuzzed, meaningless filename and
# registers it in shared/memory-wip/MEMORY-WIP.md. shared/memory-wip/ is
# whole-directory-symlinked into both CLIs already (see manifest.txt), so no
# per-item symlink step is needed here — unlike new-wip-skill.
repo_root="${0:A:h}/../.."
source "$repo_root/shared/tools/lib"

wip_root="$repo_root/shared/memory-wip"
index_file="$wip_root/MEMORY-WIP.md"

slug=$(fetch_wip_slug "$wip_root" ".md") || error "Could not find an unused fuzzed name after 5 attempts (or word-source API failed)"

echo -n "Real name (kebab-case, used only inside the encrypted content): "
read -r real_name
echo -n "Description: "
read -r description
echo -n "Type (user/feedback/project/reference): "
read -r mem_type
echo -n "Title for the index line: "
read -r title
echo -n "One-line hook for the index (shown in MEMORY-WIP.md): "
read -r hook

mkdir -p "$wip_root" || error "Failed to create $wip_root"
mem_file="$wip_root/$slug.md"
cat > "$mem_file" <<EOF || error "Failed to write $mem_file"
---
name: $real_name
description: $description
metadata:
  type: $mem_type
---

EOF

touch "$index_file"
print -r -- "- [$title]($slug.md) — $hook" >> "$index_file"

success "Created WIP memory at shared/memory-wip/$slug.md, indexed in MEMORY-WIP.md"
