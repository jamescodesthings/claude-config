#!/usr/bin/env zsh
# Force-resyncs ONE wip item from its committed ciphertext, backing up
# whatever was locally in wip first (timestamped, under wip_root/.backup/ :
# already gitignored since it's nested inside a *-wip/ root). Deliberately
# different from shared/tools/decrypt's bulk skip-existing behaviour: this is
# a human explicitly asking to overwrite one item, not a background resync
# that must never clobber uncommitted edits across the whole tree.
repo_root="${0:A:h}/../.."
type="${${0:t}%-*}"
source "$repo_root/shared/tools/lib"

slug="$1"
[[ -n "$slug" ]] || error "Usage: ${0:t} <slug>"

IFS=':' read -r wip_root enc_root shape pub_root pub_index wip_index <<< "$(wip_type_config "$type")" \
  || error "Unknown wip type '$type' (invoked as ${0:t}: expected skill-decrypt or memory-decrypt)"

load_env "$repo_root/.env"
[[ -n "$SKILLS_ENCRYPTION_KEY" ]] || error "SKILLS_ENCRYPTION_KEY not set"

item_suffix=""; [[ "$shape" == "file" ]] && item_suffix=".md"
item_wip="$wip_root/$slug$item_suffix"
item_enc="$enc_root/$slug$item_suffix"

[[ -e "$item_enc" ]] || error "No encrypted $type at ${item_enc#$repo_root/}: nothing to decrypt"

if [[ -e "$item_wip" ]]; then
  backup_dir="$wip_root/.backup"
  mkdir -p "$backup_dir" || error "Failed to create $backup_dir"
  stamp=$(date +%Y%m%d-%H%M%S)
  if [[ "$shape" == "dir" ]]; then
    cp -R "$item_wip" "$backup_dir/${slug}-${stamp}" || error "Backup failed, aborting decrypt"
  else
    cp "$item_wip" "$backup_dir/${slug}-${stamp}.md" || error "Backup failed, aborting decrypt"
  fi
  info "Backed up existing ${item_wip#$repo_root/} to ${backup_dir#$repo_root/}/${slug}-${stamp}"
fi

if [[ "$shape" == "dir" ]]; then
  "$repo_root/shared/tools/decrypt" "$item_enc" "$item_wip" || error "Decrypt failed"
else
  mkdir -p "${item_wip:h}"
  openssl enc -d -aes-256-cbc -pbkdf2 -pass env:SKILLS_ENCRYPTION_KEY -in "$item_enc" -out "$item_wip" < /dev/null \
    || error "Failed to decrypt $slug"
fi

success "Decrypted $type '$slug' into ${item_wip#$repo_root/}"
