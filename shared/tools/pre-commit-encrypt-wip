#!/usr/bin/env zsh
# Pre-commit hook: blocks any staged plaintext from a wip root (see
# shared/tools/wip-pairs), then encrypts and stages the matching encrypted
# root for any changed WIP files.
repo_root="$(git rev-parse --show-toplevel)"
source "$repo_root/shared/tools/lib"

# The plaintext block runs unconditionally: it is the guarantee this hook
# exists for, and must hold even before a key has been set up on this machine.
staged_wip=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^shared/[^/]+-wip/' | grep -v '\.gitkeep$')
if [[ -n "$staged_wip" ]]; then
  print -r -- "$staged_wip"
  error "Refusing commit: plaintext WIP file(s) staged directly"
fi

# The encrypt step needs a key. On a fresh clone there isn't one yet: warn and
# skip rather than failing every commit until the user runs create-key.
if [[ ! -f "$repo_root/.env" ]] || ! grep -q '^SKILLS_ENCRYPTION_KEY=.' "$repo_root/.env"; then
  warn "No encryption key yet: skipping WIP encrypt. Run shared/tools/create-key to enable it."
  exit 0
fi

"$repo_root/shared/tools/encrypt" || error "Encrypt failed, aborting commit"

while read -r wip_root enc_root; do
  [[ -d "$enc_root" ]] && git add "$enc_root"
done < <(wip_pairs)

exit 0
