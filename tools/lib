#!/usr/bin/env zsh
info()    { print -P "%F{blue}[info]%f  $1" }
success() { print -P "%F{green}[ok]%f    $1" }
warn()    { print -P "%F{yellow}[warn]%f  $1" }
error()   { print -P "%F{red}[error]%f $1" >&2; exit 1 }

load_env() {
  local env_file="$1"
  [[ -f "$env_file" ]] || error "missing $env_file — run 00-tools/create-key first"
  set -a
  source "$env_file"
  set +a
}
