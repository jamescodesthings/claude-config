#!/usr/bin/env zsh
source "${0:a:h}/lib"

SCRIPT_DIR=${0:a:h}
TEMPLATE="$SCRIPT_DIR/../config/ccstatusline-settings.json"
DEST="$HOME/.config/ccstatusline/settings.json"
DEST_DIR="${DEST:h}"

# ccstatusline has been retired in this repo. During install, do a best-effort
# cleanup if an old config exists, and never fail when it does not.
if [[ ! -f "$TEMPLATE" ]]; then
  if [[ -f "$DEST" ]]; then
    rm -f "$DEST" || true
    # Remove the config directory if it is now empty.
    rmdir "$DEST_DIR" 2>/dev/null || true
  fi
  exit 0
fi

mkdir -p "$(dirname "$DEST")"

if [[ -f "$DEST" ]] && [[ "$DEST" -nt "$TEMPLATE" ]]; then
  success "ccstatusline config already up to date"
  exit 0
fi

sed "s|__HOME__|$HOME|g" "$TEMPLATE" > "$DEST" || error "failed to write $DEST"
success "ccstatusline config written to $DEST"
