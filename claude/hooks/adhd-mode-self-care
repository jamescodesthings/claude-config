#!/usr/bin/env zsh
# UserPromptSubmit hook: nudges self-care (rabbit-hole, lunch, dinner, bed)
# based on the local London clock and the state file adhd-mode-session-start
# maintains. Prints nothing when no threshold is newly crossed.
#
# Lunch/dinner/bed use a cooldown, not a once-per-day flag: a single lost
# relay (hook output not surfaced in a response) used to silence that
# reminder for the rest of the day with no retry. Now it retries every
# COOLDOWN seconds for as long as the window stays open.
state_file="$HOME/.claude/.adhd-mode-state.json"
[[ -f "$state_file" ]] || exit 0

COOLDOWN=1500  # 25 minutes

now=$(TZ=Europe/London date +%s)
hhmm=$(TZ=Europe/London date +%H%M)

session_start=$(grep -o '"session_start": *[0-9]*' "$state_file" | grep -o '[0-9]*$')
last_rabbithole=$(grep -o '"last_rabbithole_nudge": *[0-9]*' "$state_file" | grep -o '[0-9]*$')
last_lunch=$(grep -o '"last_lunch_nudge": *[0-9]*' "$state_file" | grep -o '[0-9]*$')
last_dinner=$(grep -o '"last_dinner_nudge": *[0-9]*' "$state_file" | grep -o '[0-9]*$')
last_bed=$(grep -o '"last_bed_nudge": *[0-9]*' "$state_file" | grep -o '[0-9]*$')

[[ -n "$session_start" ]] || session_start=$now
[[ -n "$last_rabbithole" ]] || last_rabbithole=$session_start
[[ -n "$last_lunch" ]] || last_lunch=0
[[ -n "$last_dinner" ]] || last_dinner=0
[[ -n "$last_bed" ]] || last_bed=0

# Every line below is addressed to James, never to the model. It is a reminder
# to him, not an instruction to wind down: the model finishes the work it was
# asked for regardless of the hour. See rule 12 of the ADHD-mode skill.
messages=()

if (( now - last_rabbithole >= 9000 )); then
  messages+=("SELF-CARE: tell James he is 2.5h+ into this session: water, food, bathroom. Reminder only: keep working the task to completion.")
  last_rabbithole=$now
fi

if { [[ "$hhmm" > "1200" ]] || [[ "$hhmm" == "1200" ]]; } && [[ "$hhmm" < "1300" ]] && (( now - last_lunch >= COOLDOWN )); then
  messages+=("SELF-CARE: tell James it is lunchtime. Reminder only: keep working the task to completion.")
  last_lunch=$now
fi

if { [[ "$hhmm" > "1700" ]] || [[ "$hhmm" == "1700" ]]; } && [[ "$hhmm" < "1800" ]] && (( now - last_dinner >= COOLDOWN )); then
  messages+=("SELF-CARE: tell James to sort dinner and feed the dogs. Reminder only: keep working the task to completion.")
  last_dinner=$now
fi

# Bed window runs 23:00 through 04:59. Cooldown-based, so no calendar-day
# bookkeeping is needed for the midnight rollover: it just keeps retrying
# every COOLDOWN seconds for as long as the window is open.
if { { [[ "$hhmm" > "2300" ]] || [[ "$hhmm" == "2300" ]]; } || [[ "$hhmm" < "0500" ]]; } && (( now - last_bed >= COOLDOWN )); then
  messages+=("SELF-CARE: tell James it is past 11pm. Reminder only: keep working the task to completion.")
  last_bed=$now
fi

tmp_file="$state_file.tmp.$$"
cat > "$tmp_file" <<EOF
{
  "session_start": $session_start,
  "last_rabbithole_nudge": $last_rabbithole,
  "last_lunch_nudge": $last_lunch,
  "last_dinner_nudge": $last_dinner,
  "last_bed_nudge": $last_bed
}
EOF
mv -f "$tmp_file" "$state_file"

for m in "${messages[@]}"; do
  print -r -- "$m"
done

exit 0
