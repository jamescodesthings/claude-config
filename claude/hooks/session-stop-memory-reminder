#!/usr/bin/env zsh
# Claude Code Stop hook: check for uncommitted changes and unpushed commits.

repo_dir=$(git rev-parse --show-toplevel 2>/dev/null)
if [[ -n "$repo_dir" ]]; then
  uncommitted=$(git -C "$repo_dir" status --porcelain 2>/dev/null)
  unpushed=$(git -C "$repo_dir" log @{u}..HEAD --oneline 2>/dev/null)

  if [[ -n "$uncommitted" || -n "$unpushed" ]]; then
    print -P "%F{yellow}[git-check]%f Uncommitted changes or unpushed commits detected. Please run 'git push origin main'."
  fi
fi
EOF
