#!/usr/bin/env zsh
# Uninstalls Claude Code: the agent-forge symlinks first, then the CLI itself
# and every config, cache, and state directory it owns.
#
# The purge is the point. This pair (install, uninstall) exists so a completely
# clean install can be tested and retested, which only works if uninstall leaves
# nothing behind. Pass --no-purge to strip only agent-forge's own symlinks and
# leave the CLI installed.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$ROOT_DIR/shared/tools/lib"

purge=1
for arg in "$@"; do
  case "$arg" in
    --no-purge) purge=0 ;;
    --yes|-y)   export AGENT_FORGE_ASSUME_YES=1 ;;
    # A silently ignored --nopurge or --dry-run would leave the destructive
    # default in force, which is the worst possible way to mistype a flag.
    *) error "Unknown argument: $arg (accepted: --no-purge, --yes)" ;;
  esac
done

# Validated before anything is removed, including the symlink sweep below:
# $CLAUDE_DIR comes from the environment and everything downstream trusts it.
config_root=$(validate_purge_root "CLAUDE_CONFIG_DIR" "$CLAUDE_DIR") \
  || error "Refusing to run against an unsafe CLAUDE_CONFIG_DIR"
CLAUDE_DIR="$config_root"


info "Uninstalling Claude CLI configuration..."
clean_dead_symlinks "$CLAUDE_DIR"

for f in CLAUDE.md RTK.md settings.json .mcp.json keybindings.json statusline.sh memory memory-wip agents; do
  [[ -L "$CLAUDE_DIR/$f" ]] && rm "$CLAUDE_DIR/$f" && info "Removed Claude $f"
done

if [[ -d "$CLAUDE_DIR/skills" && ! -L "$CLAUDE_DIR/skills" ]]; then
  for f in "$CLAUDE_DIR/skills/"*(N); do
    [[ -L "$f" ]] && rm "$f" && info "Removed Claude skill symlink $(basename "$f")"
  done
fi

if [[ -d "$CLAUDE_DIR/hooks" ]]; then
  for f in "$CLAUDE_DIR/hooks/"*(N); do
    [[ -L "$f" ]] && rm "$f" && info "Removed Claude hook symlink $(basename "$f")"
  done
fi

# Run shared and Claude-specific tool uninstallers
for tool_script in "$ROOT_DIR/shared/tools/uninstall-"*(N) "$SCRIPT_DIR/tools/uninstall-"*(N); do
  [[ -x "$tool_script" ]] || continue
  info "Running $(basename "$tool_script")..."
  "$tool_script" || warn "$(basename "$tool_script") failed"
done

if (( purge )); then
  # Deliberately absent from this list:
  #   ~/Library/Application Support/Claude   the Claude desktop app, a different
  #                                          product that happens to share a name
  #   ~/.claude-monitor                      a separate tool with its own uninstaller
  purge_targets=(
    "$CLAUDE_DIR"
    "$HOME/.claude.json"
    "$HOME/.claude.json.backup"
    "$HOME/.local/share/claude"
    "$HOME/.cache/claude"
    "$HOME/Library/Caches/claude-cli-nodejs"
    $HOME/.claude.json.tmp.*(N)
  )
  # The launcher is a symlink into the version store. Only ever remove one that
  # points inside that store, so a differently-provisioned claude is left alone.
  claude_bin=$(command -v claude 2>/dev/null)
  if [[ -n "$claude_bin" ]]; then
    if [[ "$claude_bin" == "$HOME/.local/bin/"* ]]; then
      purge_targets+=("$claude_bin")
    else
      warn "claude lives at $claude_bin, outside ~/.local/bin: leaving the binary alone"
    fi
  fi

  if confirm_purge "the Claude Code CLI and all of its state" "${purge_targets[@]}"; then
    for target in "${purge_targets[@]}"; do
      purge_path "$target"
    done
    success "Claude Code CLI purged"
  fi
fi

success "Claude CLI configuration uninstalled."
