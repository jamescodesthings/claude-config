#!/usr/bin/env zsh
# Installs or updates the Claude Code plugins that ~/.claude/CLAUDE.md depends
# on: absent means install, present means update. There is no separate update
# entry point, because a split one leaves the two halves free to drift and the
# "already installed" branch then pins a version forever.
#
# CLAUDE.md routes work to `superpowers:*` skills and `commit-commands:clean_gone`.
# Neither ships with Claude Code, so if the plugins are missing the rules
# silently route to nothing: the model reads the instruction, finds no such
# skill, and carries on. Keeping this installer aligned with the skill names
# CLAUDE.md uses is what stops that.
#
# Claude-specific on purpose. It used to live in shared/tools/, which both
# claude/install and antigravity/install glob, so every Claude-only step also
# ran during the Antigravity install and vice versa.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
source "$ROOT_DIR/shared/tools/lib"

LOG_LABEL="claude-plugins"

command -v claude &> /dev/null || { warn "claude CLI not found, plugin install skipped"; exit 0 }

# marketplace_ref:plugin_name: marketplace is registered on demand.
plugins=(
  "obra/superpowers:superpowers-dev:superpowers"
  "anthropics/claude-plugins-official:claude-plugins-official:commit-commands"
)

installed=$(claude plugin list 2>/dev/null)
known=$(claude plugin marketplace list 2>/dev/null)

for entry in $plugins; do
  repo="${entry%%:*}"
  rest="${entry#*:}"
  market="${rest%%:*}"
  plugin="${rest#*:}"

  if ! print -r -- "$known" | grep -q "^ *❯ *$market\$"; then
    info "Adding marketplace $market ($repo)..."
    run_logged "$LOG_LABEL" claude plugin marketplace add "$repo" \
      || { warn "could not add marketplace $repo, skipping $plugin"; continue }
    known=$(claude plugin marketplace list 2>/dev/null)
  fi

  if print -r -- "$installed" | grep -q "$plugin@$market"; then
    info "Updating $plugin@$market..."
    # -y is not optional here. `claude plugin update --help`: "required when
    # stdin or stdout is not a TTY", which run_logged guarantees. Without it a
    # plugin whose marketplace declares an install command fails every time.
    run_logged "$LOG_LABEL" claude plugin update -y "$plugin@$market" \
      || warn "$plugin@$market update failed"
  else
    info "Installing $plugin@$market..."
    run_logged "$LOG_LABEL" claude plugin install -y "$plugin@$market" \
      || warn "$plugin@$market install failed"
  fi
done

success "Claude plugins installed and up to date"
