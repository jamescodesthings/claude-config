#!/usr/bin/env zsh
# Removes the caveman plugin from Claude Code.
#
# The old version shelled out to `npx -y github:JuliusBrussee/caveman --
# --uninstall`, which is not how the plugin got installed and left the Claude
# Code plugin registry untouched. The Antigravity half is in
# antigravity/tools/uninstall-caveman.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
source "$ROOT_DIR/shared/tools/lib"

command -v claude &> /dev/null || { warn "claude CLI not found, nothing to uninstall"; exit 0 }

if ! claude plugin list 2>/dev/null | grep -q "caveman@caveman"; then
  success "caveman not installed"
  exit 0
fi

info "Uninstalling caveman from Claude Code..."
claude plugin uninstall caveman@caveman &> /dev/null \
  || { warn "caveman uninstall failed, check 'claude plugin list'"; exit 0 }

success "caveman uninstalled"
