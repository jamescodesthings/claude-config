#!/bin/sh
# Re-exec with zsh (required). Install zsh first if missing:
#   Ubuntu/Debian: sudo apt-get install zsh
#   Arch:          sudo pacman -S zsh
#   macOS:         brew install zsh
if [ -z "$ZSH_VERSION" ]; then
  if ! command -v zsh >/dev/null 2>&1; then
    echo "[error] zsh required. Install it first:"
    echo "  Ubuntu/Debian: sudo apt-get install zsh"
    echo "  Arch:          sudo pacman -S zsh"
    echo "  macOS:         brew install zsh"
    exit 1
  fi
  exec zsh "$0" "$@"
fi

SOURCE_DIR=${0:a:h}
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
GEMINI_DIR="${GEMINI_CONFIG_DIR:-$HOME/.gemini}"
ANTIGRAVITY_HOOKS_DIR="${ANTIGRAVITY_CONFIG_DIR:-$HOME/.gemini/config/hooks}"
ANTIGRAVITY_DIR="${ANTIGRAVITY_CONFIG_DIR:-$HOME/.gemini/antigravity-cli}"

# Source the lib for helper functions (info, success, warn, error)
source "$SOURCE_DIR/tools/lib"

# ── symlink helper: idempotent, backs up real files ─────────────────────────
function symlink() {
  local src=$1 dest=$2
  if [[ -L "$dest" ]]; then
    rm "$dest"
  elif [[ -e "$dest" ]]; then
    mv "$dest" "$dest.bak"
    warn "Backed up $dest → $dest.bak"
  fi
  if ! ln -s "$src" "$dest"; then
    error "Failed to link $dest"
    return 1
  fi
  success "Linked $(basename $dest)"
}

# ── dependency check ────────────────────────────────────────────────────────
function check_deps() {
  local deps=(node npx npm curl)
  for dep in "${deps[@]}"; do
    if ! command -v "$dep" &> /dev/null; then
      echo "Dependencies:"
      echo "  node/npx/npm: https://nodejs.org/"
      echo "  curl:         https://curl.se/"
      error "$dep not found — install it first"
    fi
  done
  success "Dependencies OK"
}

# ── install claude CLI if missing ───────────────────────────────────────────
function install_claude() {
  if command -v claude &> /dev/null; then
    success "claude already installed"
    update_claude
    return
  fi
  info "Installing claude CLI..."
  curl -fsSL -o /tmp/claude-installer.sh https://claude.ai/install.sh \
    || error "Failed to download claude installer"
  chmod +x /tmp/claude-installer.sh
  /tmp/claude-installer.sh || error "claude installer failed"
  rm -f /tmp/claude-installer.sh
}

# ── Update claude CLI if it exists ───────────────────────────────────────────
function update_claude() {
  info "Updating claude..."
  OUTPUT=$(claude update 2>&1)
  if [[ $? -ne 0 ]]; then
    error "claude update failed:\n$OUTPUT"
  else
    success "claude updated"
  fi
}

# ── symlink config files ────────────────────────────────────────────────────
function link_config() {
  mkdir -p "$CLAUDE_DIR"
  local claude_dir="$CLAUDE_DIR"

  symlink "$SOURCE_DIR/claude/config/CLAUDE.md"     "$claude_dir/CLAUDE.md"
  symlink "$SOURCE_DIR/claude/config/RTK.md"        "$claude_dir/RTK.md"
  symlink "$SOURCE_DIR/claude/config/settings.json" "$claude_dir/settings.json"

  [[ -f "$SOURCE_DIR/claude/config/keybindings.json" ]] && \
    symlink "$SOURCE_DIR/claude/config/keybindings.json" "$claude_dir/keybindings.json"
}

# ── symlink individual hooks into ~/.claude/hooks/ ──────────────────────────
function link_hooks() {
  local hooks_dir="$CLAUDE_DIR/hooks"
  mkdir -p "$hooks_dir"

  for hook_file in "$SOURCE_DIR/claude/hooks/"*(N); do
    [[ -f "$hook_file" ]] || continue
    local name=$(basename "$hook_file")
    symlink "$hook_file" "$hooks_dir/$name"
    chmod +x "$hook_file"
    if ! grep -q "hooks/$name" "$SOURCE_DIR/claude/config/settings.json" &> /dev/null; then
      error "$name not registered in settings.json — hook won't fire until added"
    fi
  done
}

# ── symlink agents/ directory ───────────────────────────────────────────────
function link_agents() {
  symlink "$SOURCE_DIR/shared/agents" "$CLAUDE_DIR/agents"
}

# ── symlink each skill subfolder into ~/.claude/skills/ ─────────────────────
function link_skills() {
  local skills_target="$CLAUDE_DIR/skills"

  # If a previous install made skills_target itself a symlink (old
  # whole-directory scheme), remove it so it can become a real directory.
  [[ -L "$skills_target" ]] && rm "$skills_target"

  mkdir -p "$skills_target"

  for skill_dir in "$SOURCE_DIR/shared/skills/"*(N/); do
    symlink "$skill_dir" "$skills_target/$(basename $skill_dir)"
  done
}

# ── decrypt WIP skills, symlink each into ~/.claude/skills/ ─────────────────
function link_wip_skills() {
  local skills_target="$CLAUDE_DIR/skills"
  local wip_dir="$SOURCE_DIR/shared/skills-wip"

  if [[ ! -f "$SOURCE_DIR/.env" ]]; then
    error ".env not found — skipping WIP skills decrypt"
    return
  fi

  # Skip anything already decrypted: skills-wip/ is gitignored, so overwriting
  # local plaintext edits here would be unrecoverable.
  SKILLS_DECRYPT_SKIP_EXISTING=1 "$SOURCE_DIR/00-tools/decrypt" \
    || { error "WIP skills decrypt failed"; return }

  mkdir -p "$skills_target"

  for skill_dir in "$wip_dir/"*(N/); do
    symlink "$skill_dir" "$skills_target/$(basename $skill_dir)"
  done
}

# ── install antigravity CLI if missing ─────────────────────────────────────
function install_antigravity() {
  if command -v agy &> /dev/null; then
    success "antigravity CLI already installed"
    info "Updating antigravity..."
    agy update  &> /dev/null || error "agy update failed"
    success "antigravity up to date"
    return
  fi
  info "Installing Antigravity CLI..."
  curl -fsSL https://antigravity.google/cli/install.sh &> /dev/null | bash \
    || error "Antigravity installer failed"
}

# ── symlink Antigravity config, hooks, skills, and WIP skills plugin ─────────
function link_antigravity() {
  mkdir -p "$GEMINI_DIR/skills" "$GEMINI_DIR/hooks" "$GEMINI_DIR/config"
  mkdir -p "$ANTIGRAVITY_DIR"
  mkdir -p "$ANTIGRAVITY_HOOKS_DIR"

  [[ -f "$SOURCE_DIR/antigravity/GEMINI.md" ]] && \
    symlink "$SOURCE_DIR/antigravity/GEMINI.md" "$GEMINI_DIR/GEMINI.md"

  [[ -f "$SOURCE_DIR/antigravity/settings.json" ]] && \
    symlink "$SOURCE_DIR/antigravity/settings.json" "$ANTIGRAVITY_DIR/settings.json"

  [[ -f "$SOURCE_DIR/antigravity/hooks.json" ]] && \
    symlink "$SOURCE_DIR/antigravity/hooks.json" "$GEMINI_DIR/config/hooks.json"

  for hook_file in "$SOURCE_DIR/antigravity/hooks/"*(N); do
    [[ -f "$hook_file" ]] || continue
    symlink "$hook_file" "$ANTIGRAVITY_HOOKS_DIR/$(basename "$hook_file")"
    chmod +x "$hook_file"
  done

  for skill_dir in "$SOURCE_DIR/shared/skills/"*(N/); do
    symlink "$skill_dir" "$GEMINI_DIR/skills/$(basename "$skill_dir")"
  done

  if [[ -f "$SOURCE_DIR/.env" ]]; then
    SKILLS_DECRYPT_SKIP_EXISTING=1 "$SOURCE_DIR/00-tools/decrypt" \
      || error "WIP skills decrypt failed"
  else
    error ".env not found — skipping WIP skills decrypt"
  fi

  if [[ -f "$SOURCE_DIR/antigravity/plugin.json" ]]; then
    mkdir -p "$SOURCE_DIR/shared/skills-wip"
    cp "$SOURCE_DIR/antigravity/plugin.json" "$SOURCE_DIR/shared/skills-wip/plugin.json"
  fi

  if command -v agy &> /dev/null; then
    local output
    output=$(agy plugin install "$SOURCE_DIR/shared/skills-wip" 2>&1)
    if [[ $? -ne 0 ]]; then
      error "agy plugin install failed:\n$output"
    else
      success "Antigravity plugin installed"
    fi
  else
    error "agy CLI not found in PATH — skipping Antigravity plugin install"
  fi
}

# ── symlink the pre-commit hook ─────────────────────────────────────────────
function link_git_hook() {
  local hook_src="$SOURCE_DIR/00-tools/pre-commit-encrypt-wip"
  [[ -f "$hook_src" ]] || return
  chmod +x "$hook_src"

  # Resolve the real hooks dir: in a git worktree .git is a file, not a
  # directory, so the path can't be assumed. rev-parse handles both layouts.
  local hooks_dir
  hooks_dir=$(git -C "$SOURCE_DIR" rev-parse --git-path hooks &> /dev/null) \
    || { warn "Not a git repo — skipping pre-commit hook"; return }
  [[ "$hooks_dir" == /* ]] || hooks_dir="$SOURCE_DIR/$hooks_dir"

  mkdir -p "$hooks_dir" || { error "Could not create $hooks_dir — skipping pre-commit hook"; return }
  symlink "$hook_src" "$hooks_dir/pre-commit"
}

# ── symlink memory/ to global memory path ───────────────────────────────────
function link_global_memory() {
  local memory_dest="$CLAUDE_DIR/memory"

  symlink "$SOURCE_DIR/shared/memory" "$memory_dest"
  info "Global memory path: $memory_dest"
}

# ── symlink statusline handler ─────────────────────────────────────────────
function link_statusline() {
  local statusline_src="$SOURCE_DIR/claude/scripts/statusline.sh"
  local statusline_dest="$CLAUDE_DIR/statusline.sh"

  [[ -f "$statusline_src" ]] || { error "statusline.sh not found — skipping"; return; }
  symlink "$statusline_src" "$statusline_dest"
}

# ── sync plugins: install missing, uninstall extras ─────────────────────────
function install_plugins() {
  local settings="$SOURCE_DIR/claude/config/settings.json"
  [[ -f "$settings" ]] || { error "settings.json not found, skipping plugins"; return; }

  local desired
  desired=($(node -e "
    const s = require('$settings');
    const p = Object.keys(s.enabledPlugins || {});
    process.stdout.write(p.join('\n'));
  " &> /dev/null))

  for plugin in "${desired[@]}"; do
    [[ -z "$plugin" ]] && continue
    info "Plugin: $plugin"
    claude plugin install "$plugin"  &> /dev/null \
      || warn "$plugin: install failed or already installed"
  done

  local installed
  installed=($(claude plugin list &> /dev/null | grep '❯' | awk '{print $2}'))

  for plugin in "${installed[@]}"; do
    [[ -z "$plugin" ]] && continue
    if [[ ! " ${desired[@]} " =~ " $plugin " ]]; then
      info "Removing unlisted plugin: $plugin"
      claude plugin uninstall "$plugin" &> /dev/null \
        || error "$plugin: uninstall failed"
    fi
  done

  success "Plugins synced"
}

# ── run tool install scripts ────────────────────────────────────────────────
function install_tools() {
  for script in "$SOURCE_DIR/tools/install-"*(N); do
    [[ -x "$script" ]] || continue
    info "Running $(basename $script)..."
    "$script" || error "$(basename $script) failed — check manually"
  done
}

# ── snapshot shell rc files and prompt if tools muddied them ────────────────
ZSHRC_SNAP=""
BASHRC_SNAP=""
function snapshot_zshrc() {
  ZSHRC_SNAP=$(mktemp)
  BASHRC_SNAP=$(mktemp)
  cp "$HOME/.zshrc"  "$ZSHRC_SNAP"  &> /dev/null || true
  cp "$HOME/.bashrc" "$BASHRC_SNAP" &> /dev/null || true
}

function _check_rc() {
  local label=$1 snap=$2 target=$3
  [[ -f "$snap" ]] || return
  if ! diff -q "$snap" "$target" >/dev/null 2>&1; then
    warn "Tool installers modified ~/$label:"
    diff "$snap" "$target" | grep "^[<>]" | head -20
    printf "  Revert this change? [y/N] "
    read -r answer
    if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
      cp "$snap" "$target"
      info "~/$label restored to pre-install state"
    else
      info "~/$label changes kept"
    fi
  fi
  rm -f "$snap"
}

function check_shell_rc() {
  _check_rc ".zshrc"  "$ZSHRC_SNAP"  "$HOME/.zshrc"
  _check_rc ".bashrc" "$BASHRC_SNAP" "$HOME/.bashrc"
}

# ── zsh aliases integration ────────────────────────────────────────────────
function setup_shell_aliases() {
  local zshrc="$HOME/.zshrc"
  if ! grep -q "AI_CONFIG_DIR" "$zshrc" &> /dev/null; then
    info "Setting up shell aliases in ~/.zshrc..."
    {
      echo ""
      echo "export AI_CONFIG_DIR=\"$SOURCE_DIR\""
      echo '[[ -f "$AI_CONFIG_DIR/zsh/aliases.zsh" ]] && source "$AI_CONFIG_DIR/zsh/aliases.zsh"'
    } >> "$zshrc"
    success "Added zsh/aliases.zsh sourcing to ~/.zshrc"
  else
    info "AI_CONFIG_DIR already present in ~/.zshrc"
  fi
}

# ── write metadata ──────────────────────────────────────────────────────────
function write_metadata() {
  mkdir -p "$CLAUDE_DIR"
  echo "$SOURCE_DIR" > "$CLAUDE_DIR/.claude-config-dir"
  success "Metadata written"
}


# ── run legacy cleanup scripts ──────────────────────────────────────────────
function run_legacy() {
  local ran=0
  for script in "$SOURCE_DIR/legacy/uninstall-"*(N); do
    [[ -x "$script" ]] || continue
    info "Legacy cleanup: $(basename $script)..."
    "$script" || warn "$(basename $script) failed"
    ran=1
  done
  [[ $ran -eq 0 ]] && info "No legacy scripts"
}

# ── remove dangling symlinks in ~/.claude managed dirs ──────────────────────
function clean_dangling() {
  local dirs=(
    "$CLAUDE_DIR/skills"
    "$CLAUDE_DIR/hooks"
    "$CLAUDE_DIR/agents"
  )

  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir/"*(N); do
      if [[ -L "$f" && ! -e "$f" ]]; then
        rm "$f"
        info "Removed dangling: $f"
      fi
    done
  done
  success "Dangling symlinks cleaned"
}

# ── main ────────────────────────────────────────────────────────────────────
check_deps
install_claude
install_antigravity
run_legacy
clean_dangling
link_config
link_hooks
link_agents
link_skills
link_wip_skills
link_antigravity
link_git_hook
link_global_memory
link_statusline
install_plugins
snapshot_zshrc
install_tools
check_shell_rc
setup_shell_aliases
write_metadata

print ""
success "Agent Forge installed."
info    "Start a new shell session (or: source ~/.zshrc) to pick up PATH changes."
